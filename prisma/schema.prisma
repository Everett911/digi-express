
generator client {
  provider = "prisma-client-js"
  output   = "../.prisma/client/client"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id         String   @id @default(uuid()) @db.Uuid
  image      String[]
  name       String
  description String?
  color      String[] @default([])
  size       String[] @default([])
  priceCents Int
  keywords   String[]
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)
  isAvailableForPurchase Boolean @default(true)
  orders    Order[]
  cartItems CartItem[]

}

model Order {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String
  orderTimeMs    BigInt
  totalCostCents Int
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  user     User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  products Product[]
  PurchaseVerification PurchaseVerification[]
}

model DeliveryOption {
  id           String   @id
  deliveryDays Int
  priceCents   Int
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)


  cartItems CartItem[]
}

model CartItem {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String
  productId        String   @db.Uuid
  quantity         Int
  deliveryOptionId String
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  deliveryOption DeliveryOption @relation(fields: [deliveryOptionId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([productId])
  @@index([deliveryOptionId])
  @@unique([id, productId])
}

model User {
  id            String    @id
  name          String
  email         String
  role          String    @default("customer")
  emailVerified Boolean   @default(false)
  image         String?
  rating        Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  orders        Order[]
  cartItems     CartItem[]

  @@unique([email])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model PurchaseVerification {
  id       String   @id @default(uuid()) @db.Uuid
  orderId  String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

